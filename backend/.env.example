# Copy to backend/.env for local Docker/PostgreSQL values.
# Never commit a real .env file.

DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:8000
DJANGO_ALLOW_PUBLIC_SIGNUP=false

DEFAULT_DB_ENGINE=django.db.backends.postgresql
DEFAULT_DB_NAME=back
DEFAULT_DB_USER=back
DEFAULT_DB_PASSWORD=replace-with-a-strong-password
DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=5432

POSTGRES_DB=back
POSTGRES_USER=back
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432
POSTGRES_IMAGE=postgres:17@sha256:replace-with-verified-digest

# Production throttle cache. Override with Redis/DB cache when running multiple hosts.
DJANGO_CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
DJANGO_CACHE_LOCATION=./cache
DRF_THROTTLE_ANON=100/hour
DRF_THROTTLE_USER=1000/hour
DRF_THROTTLE_LOGIN=5/min
DRF_THROTTLE_TOKEN_REFRESH=30/min
DRF_THROTTLE_SIGNUP=10/hour
DJANGO_MAX_PRINT_UPLOAD_BODY_SIZE=110100480
DJANGO_MAX_MANUAL_CREDIT_OPERATION_AMOUNT=200
